---
import ArticleRelated from '../../components/ArticleRelated.astro';
import Page from '../../layouts/Page.astro';
import Header from '../../components/Header.astro';
import ServiceFooter from '../../components/ServiceFooter.astro';
import { blogArticles } from '../../data/blogArticles';
const articles = blogArticles.filter(article => article.status === 'published').sort((a, b) => b.dateTime.localeCompare(a.dateTime) || a.slug.localeCompare(b.slug));
const base = import.meta.env.BASE_URL;
---
<Page title="Блог — Norma Studio" description="Материалы о контент-маркетинге для бизнеса: стратегии, экспертные статьи, корпоративные блоги, SEO и GEO." image={articles[0]?.cover?.src ?? `${base}favicon.svg`}>
  <Header />
  <main id="main" class="blog-index">
    <header class="blog-index-heading container">
      <div class="hero-copy">
        <h1>Блог</h1>
        <p class="hero-intro">Про контент-маркетинг, экспертные статьи и продвижение бизнеса</p>
      </div>
    </header>
    <ArticleRelated id="blog-materials" title="Материалы блога" className="marketing-blog" hideHeading />
  </main>
  <ServiceFooter />
</Page>
<style>
  .blog-index-heading { padding-block: 170px 60px; }
  @media(max-width: 767px) {
    .blog-index-heading { padding-block: 118px 28px; }
  }
</style>
