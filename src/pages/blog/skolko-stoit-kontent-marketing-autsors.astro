---
import BlogArticle from '../../layouts/BlogArticle.astro';
import ArticleRelated from '../../components/ArticleRelated.astro';
import article from '../../data/content-marketing-cost.json';
import { costArticleCover as cover } from '../../data/blogArticles';
const slug = 'skolko-stoit-kontent-marketing-autsors';
const schema = [
  { '@context': 'https://schema.org', '@type': 'Article', headline: article.title, description: article.description, datePublished: '2026-11-18', author: { '@type': 'Organization', name: 'Norma Studio', url: 'https://norma-studio.ru/' }, mainEntityOfPage: `https://norma-studio.ru/blog/${slug}/`, image: new URL(cover.src, Astro.site).href },
  { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: article.faqs.map(item => ({ '@type': 'Question', name: item.question, acceptedAnswer: { '@type': 'Answer', text: item.answer } })) },
];
---
<BlogArticle title={article.title} seoTitle={article.seoTitle} description={article.description} category="Контент-маркетинг" date="18 ноября 2026" dateTime="2026-11-18" readingTime="15 минут" cover={cover} coverAlt="Команда обсуждает рабочие материалы" contents={article.contents}>
  <Fragment slot="intro" set:html={article.intro} />
  <Fragment set:html={article.body} />
  <script type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g, '\\u003c')} />
  <ArticleRelated slot="related" currentSlug={slug} />
</BlogArticle>
<style is:global>
  .cost-table { width: min(61.25rem, calc(100vw - 40px)); margin: 2rem 0 2rem 50%; transform: translateX(-50%); overflow-x: auto; border: 1px solid #e4d9cf; border-radius: 8px; background: #f5ebe1; }
  .cost-table table { width: 100%; min-width: 700px; border-collapse: collapse; font-size: .875rem; line-height: 1.5; }
  .cost-table th, .cost-table td { padding: 1.25rem; text-align: left; vertical-align: top; border-bottom: 1px solid #e4d9cf; }
  .cost-table th { background: #e8d9ca; color: var(--color-heading); font-weight: 500; }
  .cost-table tr:last-child td { border-bottom: 0; }
</style>
