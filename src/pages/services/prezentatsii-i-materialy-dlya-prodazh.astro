---
import Page from '../../layouts/Page.astro';
import Header from '../../components/Header.astro';
import ServiceHero from '../../components/ServiceHero.astro';
import SiteFormats from '../../components/SiteFormats.astro';
import ServiceProcess from '../../components/ServiceProcess.astro';
import ProjectShowcase from '../../components/ProjectShowcase.astro';
import ExamplesBanner from '../../components/ExamplesBanner.astro';
import CasesProcess from '../../components/CasesProcess.astro';
import ServiceDeliverables from '../../components/ServiceDeliverables.astro';
import ServiceTestimonials from '../../components/ServiceTestimonials.astro';
import ServicePricing from '../../components/ServicePricing.astro';
import ServiceConsultation from '../../components/ServiceConsultation.astro';
import ServiceFaq from '../../components/ServiceFaq.astro';
import ServiceBlog from '../../components/ServiceBlog.astro';
import ServiceFooter from '../../components/ServiceFooter.astro';
import hero from '../../assets/photos/presentations-hero.jpg';
import formatsPhoto from '../../assets/photos/presentations-formats.jpg';
import structurePhoto from '../../assets/photos/presentations-structure.jpg';
import designPhoto from '../../assets/photos/presentations-design.jpg';
import examplesBannerPhoto from '../../assets/photos/presentations-examples-banner.jpg';
import workflowPhoto from '../../assets/photos/presentations-workflow.jpg';
import consultationPhoto from '../../assets/photos/presentations-consultation.jpg';
import teamCollaboration from '../../assets/photos/team-collaboration.jpg';

const heroContent = {
  title: 'Презентации и материалы для продаж',
  intro: 'Готовим презентации и коммерческие предложения для продаж, переговоров и выступлений. Учитываем задачи, запросы и возражения ЦА. Выстраиваем структуру, пишем тексты и разрабатываем дизайн.',
  summary: 'Соберём готовые файлы в PDF, PowerPoint, Figma',
  steps: ['Изучение аудитории и задачи', 'Интервью и сбор фактуры', 'Структура и тексты', 'Дизайн, схемы и графики', 'Версии для выступления и отправки клиентам', 'Готовые файлы в PDF и PowerPoint'],
};

const formats = [
  { title: 'Презентации о компании', paragraphs: ['Для встреч и переговоров с потенциальными клиентами и партнёрами. Покажем, с какими задачами компания работает, как организует проекты и какой опыт накопила. Подберём проекты, факты и сведения о команде, которые помогут оценить её компетенции и подход к работе.'] },
  { title: 'Презентации услуг и продуктов', paragraphs: ['Поможем разобраться в предложении: кому оно подходит, какие задачи решает, как устроена работа и что получает клиент. Раскроем сценарии применения, формат услуги или возможности продукта. Покажем примеры, объясним условия и ответим на вопросы, которые возникают при выборе подрядчика.'] },
  { title: 'Коммерческие предложения', paragraphs: ['Готовим КП для использования в продажах и переговорах с клиентами. Свяжем предлагаемое решение с задачами аудитории, покажем состав работ, результаты, сроки, стоимость и условия сотрудничества. Выстроим документ так, чтобы клиент мог самостоятельно изучить предложение и обсудить с коллегами.'] },
  { title: 'Презентации для конференций и вебинаров', paragraphs: ['Разработаем структуру и слайды под тему, аудиторию и длительность выступления. Выделим основные тезисы, выстроим последовательность аргументов, подберём примеры и визуально оформим данные.'] },
  { title: 'Презентации проектов, отчётов и результатов', paragraphs: ['Для обсуждения проекта, подведения итогов и согласования дальнейших действий с руководством, заказчиками или партнёрами. Покажем информацию о задаче, процесс работы, решения, результаты и выводы. Оформим данные в графики, сравнения и схемы.'] },
];

const structure = [
  { title: 'Определяем, что важно аудитории', paragraphs: ['Уточним, кто будет смотреть презентацию, ситуацию и запросы аудитории и задачу презентации. Для продаж выясним, какие задачи стоят перед клиентами, с кем они сравнивают предложение. Для выступления определим, какие объяснения и выводы будут полезны слушателям.'] },
  { title: 'Выбираем заход и последовательность тезисов', paragraphs: ['Подберем стартовый заход, который свяжет тему презентации с интересами аудитории. Например, в презентации услуги можно начать с ситуации и проблематики клиента, объяснить подход и показать, что входит в работу и как оценивается результат, а затем раскрыть опыт компании и условия сотрудничества.', 'Для доклада определим главную мысль и выстроим объяснения, аргументы и примеры, которые помогут её раскрыть. Согласуем структуру, чтобы было понятно, какую задачу решает каждый раздел.'] },
  { title: 'Подбираем факты и примеры для аргументов', paragraphs: ['Изучим материалы компании и проведем интервью с сотрудниками. Уточним вопросы, которые возникают у клиентов, найдём фактуру для ответов: детали работы, данные, примеры и результаты проектов. Сверим с экспертами компании цифры, формулировки и другие детали.'] },
  { title: 'Напишем и отредактируем тексты', paragraphs: ['Для каждого слайда определим основную мысль и сформулируем заголовок, тезисы и пояснения. Уберём повторы, объясним термины и проверим, что выводы понятны из текста и примеров.'] },
];

const design = [
  { title: 'Согласуем визуальную концепцию', paragraphs: ['Изучим фирменный стиль и ваши пожелания, подберём референсы. Предложим сочетание шрифтов, цветов, фотографий и графики. Если фирменного стиля нет, предложим визуальное решение для презентации. Покажем, как оно работает на слайдах с разной информацией: текстом, схемой или данными. Согласуем направление перед оформлением всего материала.'] },
  { title: 'Выстроим композицию и акценты', paragraphs: ['Расположим элементы так, чтобы читатель видел главную мысль, ключевые данные и пояснения к ним. Сгруппируем связанную информацию, выделим важные цифры и выводы, подберём размеры текста и интервалы.'] },
  { title: 'Покажем сложную информацию наглядно', paragraphs: ['Для объяснения процесса нарисуем схему этапов, для сравнения вариантов оформим таблицу, для динамики показателей — график. Подберём фотографии и иллюстрации, которые помогают раскрыть тему и показать детали.', 'Выберем визуальную форму под то, что нужно объяснить. Добавим подписи и необходимые пояснения, чтобы было понятно, что сравнивается и какой вывод следует из данных.'] },
  { title: 'Оформим презентацию в едином стиле', paragraphs: ['Сохраним общие правила для заголовков, текста, изображений, таблиц и графиков во всём материале. Повторяющиеся элементы помогут ориентироваться в разделах и воспринимать презентацию как единый документ. Проверим оформление каждого слайда: выравнивание, интервалы, читаемость, подписи и качество изображений.'] },
];

const deliverables = [
  { title: 'Изучение аудитории и задачи', category: 'Аналитика' },
  { title: 'Интервью и сбор фактуры', category: 'Редакция' },
  { title: 'Структура и тексты', category: 'Редакция' },
  { title: 'Дизайн, схемы и графики', category: 'Дизайн' },
  { title: 'Версии для выступления и отправки клиентам', category: 'Дизайн' },
  { title: 'Готовые файлы в PDF и PowerPoint', category: 'Дизайн' },
];

const workflow = [
  { title: 'Уточняем задачу и планируем работу', paragraphs: ['Обсудим аудиторию, цель и ситуации использования материала. Посмотрим, что уже есть, определим нужные версии и форматы презентации.', 'Согласуем состав работ, этапы и сроки. Если презентация нужна к встрече или выступлению, учтём дедлайн. Определим, кто с вашей стороны будет участвовать в работе и согласовывать материал.'] },
  { title: 'Собираем фактуру', paragraphs: ['Изучаем документы, старые презентации, описания услуг и информацию о компании. Определяем, что можно использовать и какой фактуры не хватает.', 'Подготовим вопросы и проведём интервью. Уточним сведения, аргументы, примеры и профессиональные детали, необходимые для текста.'] },
  { title: 'Согласуем структуру и тексты', paragraphs: ['Сначала покажем план слайдов с основными тезисами. Обсудим заход, последовательность и полноту объяснений.', 'После согласования подготовим тексты. Команда клиента проверит факты, цифры и профессиональные формулировки. Соберём комментарии, внесём правки и согласуем тексты перед дизайном.'] },
  { title: 'Прорабатываем визуальное решение', text: 'Подберём референсы и покажем концепцию на примерах слайдов. Вы сможете оценить стиль, композицию и оформление разных типов информации. Обсудим комментарии и согласуем направление для всей презентации. Затем подготовим дизайн всех слайдов, схемы, графики и иллюстрации.' },
  { title: 'Проверяем и передаём готовые файлы', text: 'Соберём материал в согласованных форматах. Проверяем отображение текста и изображений, ссылки и порядок слайдов. Передадим итоговые версии в PDF, PowerPoint для встреч, выступлений и отправки.' },
];

const presentationTestimonials = [
  { quote: 'Мы запустили блог, чтобы показать будущим студентам экспертизу преподавателей. Статьи помогли нам стать заметнее на внешнем рынке и получать заявки от людей, которые сначала познакомились с университетом через полезные материалы.', name: 'Дмитрий Драй', company: 'World Class University', initials: 'ДД' },
  { quote: 'Нам нужны были статьи, которые действительно помогают выбрать экипировку и показывают, что мы разбираемся в товаре. После развития блога посещаемость выросла. Ближе к концу осени мы заметили рост продаж, особенно товаров, о которых рассказывали в статьях.', name: 'Евгений Нелюбин', company: 'World Class University', initials: 'ЕН' },
  { quote: 'Мы изменили подход к блогу: изучаем поисковые запросы и готовим материалы на темы, связанные с задачами предпринимателей. Статьи уже начали приносить лиды. Около 20% материалов находятся на первой странице поисковой выдачи, а по некоторым Яндекс формирует быстрые ответы.', name: 'Елизавета Рыжкова', company: 'inSales', initials: 'ЕР' },
  { quote: 'Нам нужны были статьи, которые действительно помогают выбрать экипировку и показывают, что мы разбираемся в товаре. После развития блога посещаемость выросла. Ближе к концу осени мы заметили рост продаж, особенно товаров, о которых рассказывали в статьях.', name: 'Евгений Нелюбин', company: 'World Class University', initials: 'ЕН' },
];

const presentationFormats = [
  { tag: 'Проект', price: 'от 40 000 рублей', title: 'Переработка презентации или КП', action: 'Обсудить задачу', items: ['Обновим материал, если изменилось предложение компании, тексты не отвечают на вопросы клиентов или оформление устарело.', 'Пересмотр структуры и аргументов.', 'Обновление фактуры и текстов.', 'Переработку дизайна и графики.', 'Сборку обновлённого материала в нужных форматах.'] },
  { tag: 'Проект', price: 'от 50 000 рублей', title: 'Разработка с нуля', action: 'Обсудить задачу', items: ['Подготовим новую презентацию или КП для продаж, переговоров или выступления. Изучим задачу и аудиторию, соберём фактуру, напишем тексты и разработаем дизайн.', 'Сбор фактуры из материалов компании и интервью с сотрудниками.', 'Структура и тексты слайдов.', 'Дизайн, схемы, таблицы и диаграммы.', 'Подготовка файлов в согласованных форматах.'] },
  { tag: 'Проект', price: 'от 60 000 рублей', title: 'Комплект материалов', action: 'Обсудить задачу', items: ['Подготовим несколько материалов для разных этапов продаж или ситуаций использования. Например, презентацию компании, документы по отдельным услугам и КП.', 'Определение задачи и структуры каждого материала.', 'Тексты с учётом аудитории и способа использования.', 'Единый стиль оформления.', 'Подготовка согласованного комплекта файлов.'] },
];

const faq = [
  { title: 'Можно ли работать с готовым текстом или презентацией?', text: 'Да. Изучим материал, проверим логику и полноту информации, определим необходимый объём работы с текстами и дизайном. Используем готовую фактуру, а недостающие сведения уточним у сотрудников компании.' },
  { title: 'Что делать, если у нас нет фирменного стиля?', text: 'Подберём шрифты, цвета, изображения и графику под вашу компанию, аудиторию и задачу. Покажем визуальную концепцию на примерах слайдов и согласуем её перед оформлением всей презентации.' },
  { title: 'Сможем ли мы редактировать презентацию самостоятельно?', text: 'Да. Заранее обсудим, в какой программе работает команда и что нужно менять: тексты, цены, цифры или изображения. Подготовим эти элементы для редактирования в согласованном формате. Состав файлов и исходников зафиксируем перед началом работы.' },
  { title: 'Как организованы правки?', text: 'Собираем комментарии по этапам: сначала к структуре и текстам, затем к визуальной концепции и оформленной презентации. Вносим согласованные изменения. Порядок и объём доработок зафиксируем в КП.' },
  { title: 'Сколько времени занимает разработка?', text: 'Срок зависит от объёма материала, готовности фактуры, сложности дизайна и согласований. После изучения задачи составим план и назовём сроки. Если презентация нужна к встрече или выступлению, заранее обсудим эту дату и возможность подготовить материал к ней.' },
  { title: 'Можно ли позже обновить презентацию или КП?', text: 'Да. Можем добавить новые услуги и кейсы, изменить цены и условия, обновить данные и графики. Изучим необходимые изменения и предложим состав работ, сроки и стоимость обновления.' },
];
---

<Page title="Презентации и материалы для продаж — Norma Studio" description={heroContent.intro} image={hero.src}>
  <Header servicesHref="#presentation-formats" blogHref="#blog" />
  <main id="main">
    <ServiceHero className="presentations-hero" content={heroContent} image={hero} mobileImage={hero} imageAlt="Специалист работает с ноутбуком и материалами" primaryHref="#consultation" secondaryAction="Посмотреть работы" secondaryHref="#presentation-projects" />
    <SiteFormats id="presentation-formats" title="Какие презентации и материалы делаем" intro="" formats={formats} image={formatsPhoto} imageAlt="Коллеги обсуждают материалы за ноутбуком" noteTitle="Если вы не выпускаете и не распространяете контент — вас просто не существует для множества потенциальных клиентов" note="Вас не добавят в шорт-лист, не обратятся за КП, не пригласят в тендер, не придут за консультацией." />
    <ServiceProcess id="presentation-structure" title="Как выстраиваем структуру и готовим контент" intro="Определим, что важно донести до аудитории и какие вопросы нужно раскрыть. Выбираем подход, выстраиваем структуру и готовим тексты." items={structure} image={structurePhoto} imageAlt="Коллеги рассматривают материалы на экране" />
    <ServiceProcess id="presentation-design" title="Как создаём дизайн и визуальную подачу" intro="Создадим современный дизайн под вашу компанию и аудиторию. Оформим презентацию так, чтобы она выглядела профессионально и была удобна для просмотра." items={design} image={designPhoto} imageAlt="Специалистка работает с материалами в студии" imageFirst />
    <ProjectShowcase id="presentation-projects" title="Примеры наших презентаций" linkLabel="Посмотреть презентацию" external={false} projects={[{ name: 'Яндекс', href: '#consultation' }, { name: 'Росатом', href: '#consultation' }, { name: 'Эконива', href: '#consultation' }, { name: 'INT', href: '#consultation' }, { name: 'ITScan', href: '#consultation' }, { name: 'Log Capital', href: '#consultation' }]} />
    <ExamplesBanner id="presentation-examples" image={examplesBannerPhoto} imageHasGradient title="Получите примеры презентаций или КП под вашу задачу" text="На консультации подберём примеры под вашу задачу и обсудим, какие структура, контент и дизайн подойдут для вашей презентации или КП." primaryAction="Получить примеры" />
    <ServiceTestimonials items={presentationTestimonials} />
    <CasesProcess id="presentation-workflow" title="Как проходит работа" intro="Начинаем с изучения имеющихся документов, черновиков и обсуждения концепции презентации. Организуем интервью, подготовку и согласования. С вашей стороны — приоритеты, фактура и проверка профессиональных деталей." items={workflow} image={workflowPhoto} imageAlt="Коллеги обсуждают презентацию" />
    <ServiceDeliverables steps={deliverables} />
    <ServicePricing title="Формат работы и стоимость" formats={presentationFormats} />
    <ExamplesBanner id="presentation-examples-more" image={teamCollaboration} />
    <ServiceConsultation className="presentations-consultation" image={consultationPhoto} title="Расскажем, какими должны быть структура, контент и дизайн вашей презентации, и подберём примеры" intro={['На встрече разберём, кому адресован материал, какую задачу он должен решить и как вы будете его использовать. Обсудим, с чего начать презентацию, какие вопросы и барьеры аудитории учесть, чем подкрепить основные аргументы.', 'Предложим подход к структуре, текстам и дизайну вашего материала. По итогам предложим состав проекта и подготовим КП со сроками и стоимостью.']} note="Даже если вы решите запускать контент самостоятельно, у вас останется понятный план действий." subject="Консультация по презентациям и материалам для продаж" greeting="Здравствуйте! Хочу обсудить презентацию или коммерческое предложение." />
    <ServiceFaq items={faq} />
    <ServiceBlog />
  </main>
  <ServiceFooter servicesHref="#presentation-formats" />
</Page>
