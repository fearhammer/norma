---
import Page from '../../layouts/Page.astro';
import Header from '../../components/Header.astro';
import ServiceHero from '../../components/ServiceHero.astro';
import SiteFormats from '../../components/SiteFormats.astro';
import ServiceProcess from '../../components/ServiceProcess.astro';
import ExamplesBanner from '../../components/ExamplesBanner.astro';
import ServiceTestimonials from '../../components/ServiceTestimonials.astro';
import CasesProcess from '../../components/CasesProcess.astro';
import ServiceDeliverables from '../../components/ServiceDeliverables.astro';
import ServicePricing from '../../components/ServicePricing.astro';
import SeoWhy from '../../components/SeoWhy.astro';
import ServiceConsultation from '../../components/ServiceConsultation.astro';
import ServiceFaq from '../../components/ServiceFaq.astro';
import ServiceBlog from '../../components/ServiceBlog.astro';
import ServiceFooter from '../../components/ServiceFooter.astro';
import hero from '../../assets/photos/seo-hero.png';
import benefitsPhoto from '../../assets/photos/seo-67072.png';
import needsPhoto from '../../assets/photos/seo-67073.png';
import typesPhoto from '../../assets/photos/seo-67074.png';
import firstBannerPhoto from '../../assets/photos/seo-67075.png';
import processPhoto from '../../assets/photos/seo-67077.png';
import secondBannerPhoto from '../../assets/photos/seo-67079.png';
import consultationPhoto from '../../assets/photos/seo-67081.png';

const heroContent = {
  title: 'SEO-статьи',
  intro: 'Пишем SEO-статьи, которые помогают привлекать внимание целевой аудитории, получать поисковый трафик и заявки.',
  steps: ['Семантика и выбор темы', 'Анализ поискового спроса и выдачи', 'Интервью и исследование', 'Текст, редактура и фактчекинг', 'SEO- и GEO-оптимизация', 'Визуалы и подготовка к публикации'],
  summary: 'Изучаем спрос и выдачу, разбираемся в продукте, проводим интервью и собираем фактуру. Пишем и редактируем текст, готовим визуалы, учитываем требования SEO и GEO и доводим материал до публикации.',
};

const benefits = [
  { title: 'Привлекают целевую аудиторию из поиска и ИИ-сервисов', paragraphs: ['Статьи отвечают на запросы потенциальных клиентов и создают дополнительные точки входа на сайт. О компании и её решениях узнают люди, которые уже изучают проблему, сравнивают подходы или ищут подходящий продукт.'] },
  { title: 'Помогают разобраться в продукте', paragraphs: ['В статье можно подробно ответить на вопросы клиентов. Из материала читатель понимает, подходит ли ему решение и чем предложение компании отличается от других вариантов.'] },
  { title: 'Показывают опыт компании', paragraphs: ['Интервью, примеры, цифры и разборы проектов делают знания команды видимыми для рынка. Потенциальный клиент может оценить подход компании до еще встречи и использовать материал при выборе подрядчика.'] },
  { title: 'Ведут читателя к следующему действию', paragraphs: ['Из статьи человек может перейти на страницу продукта, изучить кейс, подписаться на социальные сети или email-рассылку, скачать материал либо обратиться в компанию.'] },
];

const needs = [
  { title: 'В поиске и ИИ-ответах конкуренты, а не вы', paragraphs: ['Потенциальные клиенты ищут информацию по проблематике, сравнивают решения и подбирают подрядчиков. Если компания не раскрывает эти запросы, аудитория уходит к другим участникам рынка.', 'Мы найдём запросы, связанные с вашими продуктами и задачами клиентов, и подготовим под них материалы. Так у компании появятся дополнительные точки входа из поиска и ИИ-сервисов.'] },
  { title: 'Страницы сайта не получают поискового трафика', paragraphs: ['В блоге уже есть материалы, однако у них мало переходов. Возможно, статьи не соответствуют поисковой семантике, уступают другим публикациям по содержанию или раскрывают одни и те же темы.', 'Посмотрим, по каким запросам находят статьи и что предлагают другие страницы в выдаче. Проверим содержание, заголовки, метатеги и ссылки между материалами. Предложим, какие статьи дополнить, какие объединить, а какие переписать.'] },
  { title: 'Трафик есть, но мало заявок', paragraphs: ['Люди приходят за ответом, читают статью и закрывают страницу. Из текста неясно, как ваша компания может помочь с их задачей и где узнать об этом подробнее.', 'Покажем связь темы с вашим продуктом или услугой. Добавим ссылки на подходящие кейсы и материалы, предложим обратиться за консультацией там, где это уместно.'] },
  { title: 'Экспертиза остаётся внутри компании', paragraphs: ['Сотрудники могут подробно рассказать о продукте и привести примеры из практики, но на подготовку статей у них не хватает времени. Эти знания остаются в разговорах, документах и переписке.', 'Изучим материалы компании, подготовим вопросы и поговорим со специалистами. На основе собранной информации напишем статьи. Эксперту останется проверить факты и выводы.'] },
];

const types = [
  { title: 'Ответы на вопросы и инструкции', paragraphs: ['Объясним, как решить конкретную задачу: с чего начать, что подготовить и в каком порядке действовать. Расскажем, где могут возникнуть сложности и как избежать ошибок.'] },
  { title: 'Разборы проблем и способов решения', paragraphs: ['Поможем читателю разобраться, почему возникла проблема и что с ней делать. Рассмотрим способы решения, объясним, в каких случаях они подходят и как может помочь ваша компания.'] },
  { title: 'Сравнения и материалы для выбора', paragraphs: ['Сравним продукты, технологии или подходы по важным для читателя критериям. Покажем различия, преимущества и ограничения, чтобы человек мог выбрать вариант под свою задачу.'] },
  { title: 'Статьи о применении продукта', paragraphs: ['Расскажем, кому и в каких ситуациях нужен продукт. Покажем, как его используют, что потребуется для внедрения и какие задачи он поможет решить. Разберём ограничения и вопросы, которые стоит обсудить перед покупкой.'] },
  { title: 'Экспертные и аналитические статьи', paragraphs: ['Раскроем тему с помощью специалистов компании. Добавим объяснения из практики, примеры и данные. Покажем, как команда оценивает ситуацию, на чём основывает выводы и что рекомендует учитывать читателю.'] },
  { title: 'Серии статей по одному направлению', paragraphs: ['Если тема большая, разделим её на несколько материалов. В каждом ответим на отдельный вопрос: как разобраться в проблеме, сравнить решения, выбрать продукт или начать его использовать. Свяжем статьи ссылками, чтобы читатель мог найти нужные объяснения и продолжить изучение темы.'] },
];

const testimonials = [
  { quote: 'Мы запустили блог, чтобы показать будущим студентам экспертизу преподавателей. Статьи помогли нам стать заметнее на внешнем рынке и получать заявки от людей, которые сначала познакомились с университетом через полезные материалы.', name: 'Дмитрий Драй', company: 'World Class University', initials: 'ДД' },
  { quote: 'Нам нужны были статьи, которые действительно помогают выбрать экипировку и показывают, что мы разбираемся в товаре. После развития блога посещаемость выросла. Ближе к концу осени мы заметили рост продаж, особенно товаров, о которых рассказывали в статьях.', name: 'Евгений Нелюбин', company: 'World Class University', initials: 'ЕН' },
  { quote: 'Мы изменили подход к блогу: изучаем поисковые запросы и готовим материалы на темы, связанные с задачами предпринимателей. Статьи уже начали приносить лиды. Около 20% материалов находятся на первой странице поисковой выдачи, а по некоторым Яндекс формирует быстрые ответы.', name: 'Елизавета Рыжкова', company: 'inSales', initials: 'ЕР' },
  { quote: 'Нам нужны были статьи, которые действительно помогают выбрать экипировку и показывают, что мы разбираемся в товаре. После развития блога посещаемость выросла. Ближе к концу осени мы заметили рост продаж, особенно товаров, о которых рассказывали в статьях.', name: 'Евгений Нелюбин', company: 'World Class University', initials: 'ЕН' },
];

const process = [
  { title: 'Обсуждаем задачу', text: 'Определим, для кого пишем статью и как она должна помочь читателю. Обсудим, какой продукт или услугу важно раскрыть и куда человек сможет перейти после прочтения материала.' },
  { title: 'Изучаем запросы и поисковую выдачу', text: 'Изучим, как люди ищут информацию по теме и какие статьи находят. Разберёмся, что им нужно: короткий ответ, подробная инструкция, сравнение или объяснение продукта. Определим, какие вопросы раскрыть в статье.' },
  { title: 'Разбираемся в продукте', text: 'Изучим сайт, презентации, документацию и материалы для клиентов. Выясним, как работает продукт, кому подходит и какие у него ограничения. Соберем вопросы, которые нужно уточнить у команды.' },
  { title: 'Проводим интервью', text: 'Подготовим вопросы и поговорим со специалистами. Попросим объяснить сложные моменты, привести примеры из практики и рассказать о принятых решениях. Уточним, какие данные можно использовать в статье.' },
  { title: 'Пишем и редактируем', text: 'Автор выстроит структуру и подготовит текст. Редактор проверит, получили ли читатели ответы на свои вопросы, понятны ли объяснения и подтверждены ли утверждения. При необходимости вернёмся к экспертам за уточнениями деталей.' },
  { title: 'Готовим статью с учётом SEO и GEO', text: 'Распределим вопросы по разделам, подготовим заголовки и метатеги. Объясним термины, добавим примеры и сведения об опыте компании. Укажем источники данных и свяжем статью с другими страницами сайта.' },
  { title: 'Добавляем переходы на страницу продукта и других материалов', text: 'Покажем, как тема связана с вашим предложением. Добавим ссылки на услугу, продукт или подходящий кейс. Предложим подписаться или обратиться за консультацией.' },
  { title: 'Оформляем и публикуем', text: 'Подготовим обложку и нужные иллюстрации. Если тему проще объяснить схемой, таблицей или инфографикой, добавим их в материал. Разместим статью в CMS и проверим, как она выглядит на компьютере и телефоне.' },
  { title: 'Анализируем результат', text: 'Посмотрим, по каким запросам статья появляется в поиске, сколько людей переходит на страницу и что они делают после прочтения материала. По этим данным определим, что стоит доработать.' },
];

const deliverables = [
  { title: 'Семантика и выбор темы', category: 'Аналитика' },
  { title: 'Анализ поискового спроса и выдачи', category: 'Аналитика' },
  { title: 'Интервью и исследование', category: 'Редакция' },
  { title: 'Текст, редактура и фактчекинг', category: 'Редакция' },
  { title: 'SEO- и GEO-оптимизация', category: 'Техническое' },
  { title: 'Визуалы и подготовка к публикации', category: 'Дизайн' },
];

const formats = [
  { tag: 'Один материал', price: 'от 10 000 рублей', title: 'Отдельная SEO-статья', action: 'Обсудить задачу', items: ['Определим задачу статьи и изучим запросы ЦА', 'Соберём фактуру и проведём интервью', 'Напишем и отредактируем текст', 'Подготовим метатеги и внутренние ссылки', 'Оформим статью и согласуем публикацию'] },
  { tag: 'Ежемесячно', price: 'от 60 000 рублей', title: 'Регулярное производство', action: 'Обсудить задачу', items: ['Согласуем темы и объём на месяц', 'Спланируем интервью и подготовку статей', 'Напишем, отредактируем и оформим материалы', 'Согласуем их с командой и опубликуем', 'Возьмём на себя координацию и контроль выпуска'] },
  { tag: 'Серия', price: 'от 40 000 рублей', title: 'Серия материалов', action: 'Обсудить задачу', items: ['Подберём темы под продукт или направление', 'Определим, какие запросы раскроет каждая статья', 'Составим план выпуска', 'Подготовим тексты, визуалы и элементы SEO', 'Свяжем статьи между собой и со страницами продуктов'] },
];

const why = [
  { title: 'Связываем поисковый запрос с задачей бизнеса', text: 'При выборе темы учитываем спрос, продукт и следующий шаг читателя. Статья должна приводить подходящую аудиторию и помогать человеку двигаться дальше по воронке продаж.' },
  { title: 'Собираем экспертную фактуру самостоятельно', text: 'Маркетологу не нужно готовить черновик или подробное ТЗ. Изучим тему, проведём интервью и дополним материал данными из доступных источников.' },
  { title: 'Разбираемся в продуктах и сложных темах', text: 'Работаем с материалами, для которых недостаточно пересказать первые страницы поисковой выдачи. Редактор погружается в предметную область, уточняет терминологию и проверяет профессиональные выводы вместе с экспертом компании.' },
  { title: 'Соединяем SEO, GEO, редактуру и дизайн', text: 'SEO-специалист, редактор, автор и дизайнер работают над общей задачей. Компания получает цельный материал, подготовленный для поиска, ИИ-сервисов и читателей.' },
  { title: 'Проводим аналитику после публикации', text: 'Смотрим, есть ли у статьи показы и переходы, по каким запросам её находят и какой следующий шаг делают читатели. Используем данные для обновления материала и планирования следующих тем.' },
];

const faq = [
  { title: 'Можно ли начать без контент-стратегии?', text: 'Да. Начнём с конкретной задачи и одного материала или серии статей. Изучим спрос и предложим темы, а затем при необходимости поможем выстроить регулярный выпуск.' },
  { title: 'Кто придумывает темы?', text: 'Можем работать по вашей семантике и SEO-ТЗ или сами изучить запросы аудитории, поисковую выдачу и продукт, после чего предложить темы и структуру.' },
  { title: 'Нужно ли готовить подробное техническое задание?', text: 'Нет. Расскажите о продукте, аудитории и задаче. Мы уточним детали, изучим материалы и подготовим план статьи.' },
  { title: 'Сколько времени потребуется от экспертов?', text: 'Обычно нужна беседа для сбора фактуры и проверка готового текста. Заранее подготовим вопросы, чтобы использовать время специалистов эффективно.' },
  { title: 'Можете ли вы вести блог под ключ?', text: 'Да. Можем планировать темы, проводить интервью, писать и редактировать статьи, оформлять их, публиковать и анализировать результаты.' },
  { title: 'Гарантируете ли вы трафик, заявки или попадание в ИИ-ответы?', text: 'Нет: эти результаты зависят не только от статьи, но и от сайта, конкуренции и работы поисковых систем. Мы изучаем спрос, готовим материал и отслеживаем его показатели после публикации.' },
  { title: 'Можно ли работать вместе со штатной редакцией?', text: 'Да. Согласуем зоны ответственности: можем брать отдельные статьи или этапы работы и взаимодействовать с вашей редакцией и экспертами.' },
  { title: 'Входит ли дизайн в стоимость?', text: 'Состав визуалов зависит от формата материала. Обложку, иллюстрации, схемы и оформление обсудим до начала работы и включим в предложение.' },
  { title: 'Сколько стоит контент-маркетинг?', text: 'Отдельная SEO-статья — от 10 000 рублей, серия материалов — от 40 000 рублей, регулярное производство — от 60 000 рублей. Точную стоимость определим после обсуждения задачи.' },
];
---

<Page title="SEO-статьи — Norma Studio" description="Пишем SEO-статьи для поискового трафика и заявок: изучаем спрос, собираем фактуру, готовим текст, визуалы и публикацию." image={hero.src}>
  <Header servicesHref="#benefits" blogHref="#blog" />
  <main id="main">
    <ServiceHero content={heroContent} image={hero} mobileImage={hero} imageAlt="Эксперт за рабочим столом" className="seo-hero" />
    <SiteFormats id="benefits" title="Что SEO-статьи дают бизнесу" intro="Потенциальные клиенты ищут информацию о своей проблеме, сравнивают способы решения и изучают подрядчиков. SEO-статьи помогают получить контакт с этой аудиторией в поиске и ИИ-сервисах, объяснить продукт и привести читателя к следующему действию." formats={benefits} image={benefitsPhoto} imageAlt="Коллеги рассматривают материалы на ноутбуке" />
    <ServiceProcess id="needs" title="Когда компании нужны SEO-статьи" intro="Подключимся, если компании нужно получать целевой трафик из поиска, рассказывать про продукты и регулярно выпускать материалы, а собственной команде не хватает времени или редакционных ресурсов." items={needs} image={needsPhoto} imageAlt="Рука закрывает ноутбук на столе" />
    <ServiceProcess id="types" title="Какие SEO-статьи делаем" intro="Посмотрим, что люди ищут по вашей теме и какие вопросы им нужно раскрыть. Подберём формат: пошаговую инструкцию, сравнение вариантов, разбор проблемы или статью о применении продукта." items={types} image={typesPhoto} imageAlt="Рабочее место с компьютером, чашкой кофе и очками" imageFirst />
    <ExamplesBanner id="presentation-examples" image={firstBannerPhoto} title="Получите примеры презентаций или КП под вашу задачу" text="На консультации подберём примеры под вашу задачу и обсудим, какие структура, контент и дизайн подойдут для вашей презентации или КП." />
    <ServiceTestimonials items={testimonials} />
    <CasesProcess id="seo-process" title="Как мы готовим SEO-статьи" intro="Выберем тему, изучим продукт, поговорим со специалистами, напишем и опубликуем статью. С вашей стороны понадобятся материалы компании, участие экспертов и проверка текста. Организацию работы берём на себя." items={process} image={processPhoto} imageAlt="Специалист печатает за ноутбуком" />
    <ServiceDeliverables steps={deliverables} />
    <ServicePricing title="Формат работы и стоимость" intro="Подготовим статьи по вашей семантике и SEO-ТЗ или сами изучим спрос и предложим темы и структуру материалов." formats={formats} />
    <ExamplesBanner id="project-examples" image={secondBannerPhoto} />
    <SeoWhy items={why} />
