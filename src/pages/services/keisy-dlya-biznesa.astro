---
import Page from '../../layouts/Page.astro';
import Header from '../../components/Header.astro';
import CasesHero from '../../components/CasesHero.astro';
import CasesNeeds from '../../components/CasesNeeds.astro';
import ServiceProcess from '../../components/ServiceProcess.astro';
import ServiceDeliverables from '../../components/ServiceDeliverables.astro';
import ServiceTestimonials from '../../components/ServiceTestimonials.astro';
import ExamplesBanner from '../../components/ExamplesBanner.astro';
import CasesProcess from '../../components/CasesProcess.astro';
import ServicePricing from '../../components/ServicePricing.astro';
import CasesUseCases from '../../components/CasesUseCases.astro';
import ServiceConsultation from '../../components/ServiceConsultation.astro';
import ServiceFaq from '../../components/ServiceFaq.astro';
import ServiceBlog from '../../components/ServiceBlog.astro';
import ServiceExperts from '../../components/ServiceExperts.astro';
import ChannelBanner from '../../components/ChannelBanner.astro';
import ServiceFooter from '../../components/ServiceFooter.astro';
import hero from '../../assets/photos/cases-hero.png';
import benefitsImage from '../../assets/photos/cases-benefits.jpg';
import examplesImage from '../../assets/photos/cases-examples.jpg';
import consultationImage from '../../assets/photos/cases-benefits.jpg';
import teamCollaboration from '../../assets/photos/team-collaboration.jpg';

const benefits = [
  {
    title: 'Показывают опыт в похожей ситуации',
    paragraphs: [
      'Для читателя важны условия проекта: что нужно было изменить, какой объём работы выполнить и какие ограничения учесть. Например, требовалось внедрить продукт без остановки работы или связать его с уже используемыми системами.',
      'Такие детали помогают понять, сталкивалась ли компания с похожими требованиями и какой опыт может применить в новом проекте.',
    ],
  },
  {
    title: 'Помогают понять подход команды',
    paragraphs: [
      'В кейсе можно объяснить, почему специалисты выбрали определённое решение, какие варианты рассматривали и как действовали при возникновении трудностей. Отдельно показать, за что отвечала команда исполнителя, а что делал заказчик или другие участники.',
      'Потенциальный клиент сможет оценить ход работы и подготовить уточняющие вопросы по своей задаче.',
    ],
  },
  {
    title: 'Показывают, что получил заказчик',
    paragraphs: [
      'В кейсе расскажем о результатах проекта: что удалось сделать, какую проблему решить и что изменилось в работе заказчика. Если есть цифры, покажем разницу до и после. Если нет — опишем результат словами.',
      'Так потенциальный клиент сможет понять, какую пользу принесла работа компании, и обсудить с коллегами, что из этого важно для их задачи.',
    ],
  },
];

const deliverables = [
  { title: 'Интервью и сбор фактуры', category: 'Аналитика' },
  { title: 'Проверка фактов и результатов', category: 'Редакция' },
  { title: 'Текст и редактура', category: 'Редакция' },
  { title: 'Дизайн и адаптация материалов', category: 'Дизайн' },
];

const formats = [
  {
    tag: 'Старт', price: 'от 20 000 рублей', title: 'Один кейс', action: 'Обсудить задачу',
    items: ['Выберем проект и определим задачу кейса', 'Изучим материалы и проведём интервью', 'Напишем и отредактируем текст', 'Подготовим визуалы и оформление', 'Согласуем материал и опубликуем готовую версию'],
  },
  {
    tag: 'Ежемесячно', price: 'от 60 000 рублей', title: 'Серия кейсов', action: 'Обсудить задачу',
    items: ['Подберём проекты под нужные направления и запросы аудитории', 'Определим очерёдность подготовки кейсов', 'Соберём фактуру и проведём интервью по каждому проекту', 'Подготовим тексты и согласуем оформление серии', 'Организуем проверку и согласование материалов'],
  },
  {
    tag: 'Отдельные задачи', price: 'от 25 000 рублей', title: 'Доработка кейсов', action: 'Обсудить задачу',
    items: ['Изучим существующие кейсы и исходные материалы', 'Определим, каких сведений не хватает', 'При необходимости проведём дополнительные интервью', 'Переработаем структуру и текст', 'Если необходимо — обновим дизайн'],
  },
];

const faq = [
  { title: 'Сколько стоит подготовка кейса?', text: 'Стоимость зависит от объёма работ: нужно ли проводить интервью, сколько фактуры собрать, потребуется ли дизайн и дополнительные версии для презентации, рассылки или других каналов. После знакомства с задачей подготовим предложение с составом работ, сроками и стоимостью.' },
  { title: 'Сколько времени занимает работа?', text: 'Обычно подготовка одного кейса занимает от двух до четырёх недель. Срок зависит от количества интервью, готовности материалов и времени, которое потребуется на согласование.' },
  { title: 'Что нужно подготовить для старта работ?', text: 'Достаточно рассказать о проекте и передать доступные материалы: презентации, документы, отчёты, ссылки, отзывы. Поможем понять, чего не хватает, и составим план сбора фактуры.' },
  { title: 'Нужно ли сотрудникам самим писать кейс?', text: 'Нет. Мы проведём интервью, соберём факты, напишем и отредактируем текст. От сотрудников понадобится время на разговор о проекте и проверку деталей.' },
  { title: 'Обязательно ли интервью с заказчиком проекта?', text: 'Нет. Обычно достаточно поговорить с участниками со стороны исполнителя. Если интервью с заказчиком поможет точнее показать результат, обсудим это отдельно.' },
  { title: 'Можно ли сделать кейс без точных цифр?', text: 'Да. Если показатели нельзя раскрывать или их нет, опишем результат через изменения в процессе, продукте или работе команды. При этом подскажем, какие факты помогут сделать материал убедительнее.' },
  { title: 'Что делать, если нельзя назвать заказчика?', text: 'Подготовим анонимный кейс: не будем называть компанию и сотрудников, изменим или обобщим чувствительные детали. Сохраним суть задачи, подход и результат.' },
  { title: 'Входят ли дизайн кейса и версии для других каналов в стоимость?', text: 'Это зависит от выбранного формата. Подготовим материал для сайта, а при необходимости сделаем версии для презентации, отдела продаж, рассылки или социальных сетей. Состав работ согласуем до старта.' },
];
---

<Page
  title="Кейсы для бизнеса — Norma Studio"
  description="Соберём фактуру, подготовим текст и дизайн кейса для сайта, презентаций и отдела продаж."
  image={hero.src}
>
  <Header servicesHref="/services/razrabotka-saitov/#formats" blogHref="/services/razrabotka-saitov/#blog" />
  <main id="main">
    <CasesHero />
    <CasesNeeds />
    <ServiceProcess id="case-benefits" title="Как кейсы помогают выбрать подрядчика" intro="Изучив кейс, потенциальный клиент может оценить опыт компании до встречи. Он видит, с какими задачами работала команда, как принимала решения и чего достигла. Эти сведения помогают сравнить исполнителей и обсудить выбор с коллегами." items={benefits} image={benefitsImage} imageAlt="Специалист работает за ноутбуком" />
    <ServiceTestimonials />
    <CasesProcess />
    <ServiceDeliverables steps={deliverables} />
    <ExamplesBanner id="case-examples" image={examplesImage} />
    <CasesUseCases />
    <ServiceExperts id="experts" />
    <ServicePricing title="Форматы сотрудничества" formats={formats} />
    <ExamplesBanner id="case-examples-more" image={teamCollaboration} />
    <ServiceConsultation image={consultationImage} title="Какие проекты можно упаковать в кейсы — разберём на встрече" intro={['Обсудим, каким сегментам потенциальных клиентов вы хотите рассказать про свой опыт и как планируете использовать материалы. Разберём примеры кейсов, которые подойдут для вашей задачи.', 'Подготовим предложение на один кейс, серию или доработку существующих материалов с составом работ, сроками и стоимостью.']} subject="Консультация по кейсам для бизнеса" greeting="Здравствуйте! Хочу обсудить кейсы для компании." />
    <ServiceFaq items={faq} />
    <ChannelBanner spaced />
    <ServiceBlog />
  </main>
  <ServiceFooter />
</Page>
