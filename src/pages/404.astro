---
import Page from '../layouts/Page.astro';
const base = import.meta.env.BASE_URL;
---
<Page title="Страница не найдена — Norma Studio" description="Страница не найдена. Вернитесь на главную страницу Norma Studio." image={`${base}favicon.svg`} noindex>
  <main id="main" class="not-found">
    <a class="brand" href={base} aria-label="Norma Studio — главная">Norma Studio</a>
    <div class="error-content">
      <p class="error-code">404</p>
      <h1>Страница не найдена</h1>
      <p class="error-description">Возможно, адрес изменился или в ссылке есть ошибка.</p>
      <a class="home-link" href={base}>На главную <span aria-hidden="true">→</span></a>
    </div>
    <p class="wordmark" aria-hidden="true">Norma Studio</p>
  </main>
</Page>
<style is:global>
  html:has(.not-found), body:has(.not-found) { background: #251f19; }
</style>
<style>
  .not-found { min-height: 100svh; display: flex; flex-direction: column; overflow: hidden; color: #e9e9e9; background: #251f19; padding: 32px max(24px, calc((100vw - var(--container)) / 2)) 0; }
  .brand { align-self: flex-start; color: inherit; font-size: 1.375rem; text-decoration: none; }
  .error-content { padding-block: 70px 80px; flex: 1; }
  .error-code { margin: 0 0 24px; font-size: clamp(5rem, 12vw, 11rem); line-height: .9; font-weight: 350; letter-spacing: -.06em; }
  h1 { color: inherit; font-weight: 350; font-size: clamp(2rem, 4vw, 3.375rem); line-height: 1.05; letter-spacing: -.03em; margin: 0; }
  .error-description { margin: 24px 0 32px; color: #c7bbb0; max-width: 35rem; }
  .home-link { display: inline-flex; gap: 24px; align-items: center; padding: 14px 22px; border-radius: 30px; color: #251f19; background: #f6f0ea; text-decoration: none; }
  .home-link:hover { background: #e6d3c2; }
  .wordmark { margin: 0 0 -.15em; font-size: clamp(3.75rem, 13.8vw, 16rem); line-height: 1; letter-spacing: -.065em; white-space: nowrap; }
  @media(max-width: 767px) { .error-content { padding-block: 70px; } }
</style>
