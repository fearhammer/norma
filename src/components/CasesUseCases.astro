---
import { Image } from 'astro:assets';
import image from '../assets/photos/cases-use.jpg';

const items = [
  {
    title: 'На сайте',
    paragraphs: ['Подготовим полную версию кейса. Расскажем, как связать её со страницами услуг и продуктов, чтобы посетитель мог изучить всю информацию по своей задаче, а затем обратиться на консультацию.'],
  },
  {
    title: 'В презентациях и работе отдела продаж',
    paragraphs: ['Сократим кейс для презентации: оставим задачу клиента, основные решения и результат. Так менеджер сможет показать подходящий пример на встрече или отправить его вместе с коммерческим предложением.', 'Для тендера подготовим описание проекта по требованиям заказчика.'],
  },
  {
    title: 'В рассылке и социальных сетях',
    paragraphs: ['На основе кейса подготовим письмо для рассылки или пост для социальных сетей. Коротко расскажем о проекте и дадим ссылку на полную версию.', 'Если в проекте есть тема для отдельной публикации, раскроем её подробнее: например, с какой трудностью столкнулась команда, как выбирала решение и что получилось.', 'Нужные версии, оформление, размещение и распространение согласуем в составе работ.'],
  },
];
---

<section class="cases-use" id="case-use" aria-labelledby="case-use-title">
  <div class="container cases-use-content">
    <div class="section-intro">
      <h2 id="case-use-title">Где использовать готовый кейс</h2>
      <p>Про один проект можно рассказать в нескольких форматах.</p>
    </div>
    <ol class="cases-use-list">
      {items.map((item, index) => (
        <li>
          <span class="format-number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
          <h3>{item.title}</h3>
          {item.paragraphs.map(paragraph => <p>{paragraph}</p>)}
        </li>
      ))}
    </ol>
  </div>
  <Image class="cases-use-photo" src={image} alt="Команда обсуждает проект" widths={[800, 1200, 1600, 2000]} sizes="100vw" format="webp" loading="lazy" decoding="async" />
</section>
