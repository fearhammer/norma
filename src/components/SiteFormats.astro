---
import { websiteService as content } from '../data/website-service';
import { Image } from 'astro:assets';
import notebookPhoto from '../assets/photos/notebook-bag.jpg';
---
<section class="site-formats" id="formats" aria-labelledby="formats-title">
  <div class="container formats-content">
  <div class="section-intro">
    <h2 id="formats-title">Какие сайты делаем</h2>
    <p>{content.formatsIntro}</p>
  </div>
  <ol class="format-list">
    {content.formats.map((format, index) => (
      <li>
        <span class="format-number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
        <h3>{format.title}</h3>
        {format.paragraphs.map(paragraph => <p>{paragraph}</p>)}
      </li>
    ))}
  </ol>
  </div>
  <div class="formats-photo" data-parallax>
    <Image src={notebookPhoto} alt="Коллега убирает блокнот в сумку, сидя на диване в студии" widths={[640, 960, 1440, 1920]} sizes="100vw" format="webp" quality={90} loading="lazy" decoding="async" />
  </div>
  <div class="container">
    <aside class="formats-note">
      <p class="formats-note-title">Если вы не выпускаете и не распространяете контент — вас просто не существует для множества потенциальных клиентов</p>
      <p>Вас не добавят в шорт-лист, не обратятся за КП, не пригласят в тендер, не придут за консультацией.</p>
    </aside>
  </div>
</section>
