---
import { Image } from 'astro:assets';
import project0Image0 from '../assets/projects/presentations/yandex/1.jpg';
import project0Image1 from '../assets/projects/presentations/yandex/2.jpg';
import project0Image2 from '../assets/projects/presentations/yandex/3.jpg';
import project0Image3 from '../assets/projects/presentations/yandex/4.jpg';
import project0Image4 from '../assets/projects/presentations/yandex/5.jpg';
import project0Image5 from '../assets/projects/presentations/yandex/6.jpg';
import project0Image6 from '../assets/projects/presentations/yandex/7.jpg';
import project0Image7 from '../assets/projects/presentations/yandex/8.jpg';
import project1Image0 from '../assets/projects/presentations/rosatom/1.png';
import project1Image1 from '../assets/projects/presentations/rosatom/2.png';
import project1Image2 from '../assets/projects/presentations/rosatom/3.png';
import project1Image3 from '../assets/projects/presentations/rosatom/4.png';
import project1Image4 from '../assets/projects/presentations/rosatom/5.png';
import project2Image0 from '../assets/projects/presentations/ekoniva/1.png';
import project2Image1 from '../assets/projects/presentations/ekoniva/2.png';
import project2Image2 from '../assets/projects/presentations/ekoniva/3.png';
import project2Image3 from '../assets/projects/presentations/ekoniva/4.png';
import project2Image4 from '../assets/projects/presentations/ekoniva/5.png';
import project3Image0 from '../assets/projects/presentations/coferium/1.png';
import project3Image1 from '../assets/projects/presentations/coferium/2.png';
import project3Image2 from '../assets/projects/presentations/coferium/3.png';
import project3Image3 from '../assets/projects/presentations/coferium/4.png';
import project3Image4 from '../assets/projects/presentations/coferium/5.png';
import project4Image0 from '../assets/projects/presentations/it-scan/1.png';
import project4Image1 from '../assets/projects/presentations/it-scan/2.png';
import project4Image2 from '../assets/projects/presentations/it-scan/3.png';
import project4Image3 from '../assets/projects/presentations/it-scan/4.png';
import project4Image4 from '../assets/projects/presentations/it-scan/5.png';

const projects = [{ id: 'yandex', title: 'Яндекс: презентация для инвесторов', color: 'rgb(242, 93, 55)', collage: true, images: [{ src: project0Image0, background: 'rgba(0, 0, 0, 0)' }, { src: project0Image1, background: 'rgba(0, 0, 0, 0)' }, { src: project0Image2, background: 'rgba(0, 0, 0, 0)' }, { src: project0Image3, background: 'rgba(0, 0, 0, 0)' }, { src: project0Image4, background: 'rgba(0, 0, 0, 0)' }, { src: project0Image5, background: 'rgba(0, 0, 0, 0)' }, { src: project0Image6, background: 'rgba(0, 0, 0, 0)' }, { src: project0Image7, background: 'rgba(0, 0, 0, 0)' }] },
{ id: 'rosatom', title: 'Росатом: презентация проекта', color: 'rgb(2, 94, 161)', collage: false, images: [{ src: project1Image0, background: 'rgb(245, 245, 245)' }, { src: project1Image1, background: 'rgb(32, 32, 32)' }, { src: project1Image2, background: 'rgb(242, 242, 242)' }, { src: project1Image3, background: 'rgb(242, 242, 242)' }, { src: project1Image4, background: 'rgb(32, 32, 32)' }] },
{ id: 'ekoniva', title: 'ЭкоНива: презентация проекта', color: 'rgb(12, 84, 46)', collage: false, images: [{ src: project2Image0, background: 'rgb(250, 246, 241)' }, { src: project2Image1, background: 'rgb(0, 67, 28)' }, { src: project2Image2, background: 'rgb(250, 246, 241)' }, { src: project2Image3, background: 'rgb(250, 246, 241)' }, { src: project2Image4, background: 'rgb(0, 67, 28)' }] },
{ id: 'coferium', title: 'Coferium: презентация проекта', color: 'rgb(199, 42, 41)', collage: false, images: [{ src: project3Image0, background: 'rgb(236, 231, 224)' }, { src: project3Image1, background: 'rgb(213, 193, 173)' }, { src: project3Image2, background: 'rgb(236, 231, 224)' }, { src: project3Image3, background: 'rgb(236, 231, 224)' }, { src: project3Image4, background: 'rgb(213, 193, 173)' }] },
{ id: 'it-scan', title: 'IT Scan: презентация проекта', color: 'rgb(15, 99, 169)', collage: false, images: [{ src: project4Image0, background: 'rgb(231, 240, 247)' }, { src: project4Image1, background: 'rgb(0, 79, 149)' }, { src: project4Image2, background: 'rgb(231, 240, 247)' }, { src: project4Image3, background: 'rgb(231, 240, 247)' }, { src: project4Image4, background: 'rgb(0, 79, 149)' }] }];
---
<section class="project-showcase presentation-projects container" id="presentation-projects" aria-labelledby="presentation-projects-title">
  <h2 id="presentation-projects-title">Примеры реализованных проектов</h2>
  <div class="presentation-project-list">
    {projects.map(project => (
      <article class="presentation-project" style={`--project-color: ${project.color}`} aria-labelledby={`project-${project.id}-title`}>
        <h3 id={`project-${project.id}-title`}>{project.title}</h3>
        {project.collage ? (
          <>
            <div class="presentation-collage">
              {project.images.slice(0, 4).map((image, index) => <Image src={image.src} alt={`${project.title} — слайд ${index + 1}`} widths={[480, 800, 1200, 1480]} sizes="(max-width: 767px) 40vw, 42vw" format="webp" quality={95} loading="lazy" />)}
            </div>
            <div class="presentation-detail-grid">
              {project.images.slice(4).map((image, index) => <div class:list={['presentation-slide', { 'presentation-slide--dark': index === 0 || index === 3 }]}><Image src={image.src} alt={`${project.title} — слайд ${index + 5}`} widths={[480, 800, 1200, 1480]} sizes="(max-width: 767px) 80vw, 42vw" format="webp" quality={95} loading="lazy" /></div>)}
            </div>
          </>
        ) : (
          <>
            <Image class="presentation-overview" src={project.images[0].src} alt={`${project.title} — обзор четырёх слайдов`} style={`background-color: ${project.images[0].background}`} widths={[640, 960, 1440, 1860]} sizes="(max-width: 767px) calc(100vw - 72px), (min-width: 1600px) 1380px, 1140px" format="webp" quality={95} loading="lazy" />
            <div class="presentation-detail-grid">
              {project.images.slice(1).map((image, index) => <Image src={image.src} alt={`${project.title} — слайд ${index + 5}`} style={`background-color: ${image.background}`} widths={[480, 720, 915]} sizes="(max-width: 767px) calc(100vw - 72px), (min-width: 1600px) 675px, 555px" format="webp" quality={95} loading="lazy" />)}
            </div>
          </>
        )}
      </article>
    ))}
  </div>
</section>
<style>
  .presentation-projects { scroll-margin-top: 90px; }
  .presentation-project-list { display: grid; gap: 40px; margin-top: 48px; }
  .presentation-project { min-width: 0; padding: 30px; border-radius: 10px; background: var(--project-color); }
  .presentation-project h3 { margin: 0 0 30px; color: #fff; font-size: clamp(2rem, 4vw, 3.25rem); line-height: .98; font-weight: 500; letter-spacing: -.04em; text-align: left; }
  .presentation-project img { display: block; width: 100%; height: auto; }
  .presentation-overview, .presentation-detail-grid > img, .presentation-collage, .presentation-slide { border-radius: 10px; overflow: hidden; }
  .presentation-detail-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 20px; margin-top: 20px; }
  .presentation-collage { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); align-content: center; gap: 16px; padding: 9.2%; aspect-ratio: 1860 / 1221; background: #f2f2f2; }
  .presentation-collage img { box-shadow: 0 8px 20px rgb(0 0 0 / .15); }
  .presentation-slide { display: grid; align-items: center; aspect-ratio: 915 / 640; padding: 9%; background: #f2f2f2; }
  .presentation-slide--dark { background: #202020; }
  @media (max-width: 767px) {
    .presentation-project-list { gap: 28px; margin-top: 32px; }
    .presentation-project { padding: 16px; }
    .presentation-project h3 { margin-bottom: 24px; font-size: 2rem; }
    .presentation-detail-grid { grid-template-columns: 1fr; gap: 16px; margin-top: 16px; }
    .presentation-collage { gap: 6px; }
  }
</style>
