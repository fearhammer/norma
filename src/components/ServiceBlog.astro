---
import ArticleRelated from './ArticleRelated.astro';
import { showEditorialSections } from '../data/features';
interface Props { className?: string; }
const { className = '' } = Astro.props;
---
{showEditorialSections && <ArticleRelated id="blog" className={`marketing-blog ${className}`} title="Читайте про контент-маркетинг в блоге Norma Studio" includePreviews />}
