  name: 'Log Capital',
  href: 'https://logcap.ru/',
  images: [logCapital01, logCapital02, logCapital03, logCapital04, logCapital05, logCapital06, logCapital07, logCapital08, logCapital09],
}, {
  name: 'Prokol24',
  href: 'http://prokol24.ru/',
  images: [prokol24_01, prokol24_02, prokol24_03, prokol24_04, prokol24_05, prokol24_06, prokol24_07],
