  name: 'Hilton',
  href: 'https://moscow-leningradskaya.ru/',
  images: [hilton01, hilton02, hilton03, hilton04, hilton05, hilton06],
}, {
  name: 'Blaster',
  href: 'https://www.blstr.ru/',
  images: [blaster03, blaster01, blaster02, blaster04, blaster05, blaster06, blaster07, blaster08, blaster09, blaster10],
