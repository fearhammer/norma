---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

const items = [
  {
    title: 'Обсуждаем задачу',
    text: 'Выясним, кому вы хотите показать кейс и где будете его использовать. Выберем проект, договоримся о составе работ, сроках и стоимости. Определим, кто из сотрудников сможет рассказать о проекте и кто будет согласовывать материал.',
  },
  {
    title: 'Изучаем материалы и проводим интервью',
    text: 'Посмотрим документы, отчёты и презентации. Подготовим вопросы и поговорим с сотрудниками: какая стояла задача, как работала команда, какие трудности возникли и чем всё закончилось. При необходимости уточняем детали.',
  },
  {
    title: 'Готовим текст и дизайн',
    text: 'Автор напишет кейс на основе документов и интервью. Редактор проверит, понятен ли рассказ, хватает ли объяснений и подтверждены ли факты. Дизайнер оформит материал, добавит нужные схемы, изображения и подписи.',
  },
  {
    title: 'Собираем правки',
    text: 'Отправим кейс для проверки деталей и сбора комментариев. Внесём правки. Если требуется согласование с заказчиком проекта, учтём его замечания и уточним, какие сведения можно публиковать.',
  },
  {
    title: 'Передаём или публикуем кейс',
    text: 'Передадим готовый материал и дополнительные версии, о которых договорились на старте. Если публикация входит в работу, разместим кейс на сайте или в другом выбранном канале.',
  },
];

interface Props {
  id?: string;
  title?: string;
  intro?: string;
  items?: { title: string; text?: string; paragraphs?: string[] }[];
  image?: ImageMetadata;
  imageAlt?: string;
}

const {
  id = 'case-process',
  title = 'Как проходит работа над кейсом',
  intro = 'Изучим проект, поговорим с участниками, напишем текст и оформим кейс. С вашей стороны понадобятся информация о проекте, время сотрудников на интервью и проверку итогового материала.',
  items: processItems = items,
  image,
  imageAlt = '',
} = Astro.props;
---

<section class="cases-process container section-space" id={id} aria-labelledby={`${id}-title`}>
  <div class="section-intro">
    <h2 id={`${id}-title`}>{title}</h2>
    <p>{intro}</p>
  </div>
  <ol class="cases-process-card">
    {processItems.map((item, index) => (
      <li>
        <span class="format-number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
        <h3>{item.title}</h3>
        {(item.paragraphs ?? (item.text ? [item.text] : [])).map(paragraph => <p>{paragraph}</p>)}
      </li>
    ))}
  </ol>
  {image && <Image class="cases-process-photo" src={image} alt={imageAlt} widths={[800, 1200, 1600, 2000]} sizes="100vw" format="webp" quality={95} loading="lazy" decoding="async" />}
</section>
