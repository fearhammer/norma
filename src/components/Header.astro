---
// Адреса существующего сайта сохраняются до подготовки остальных страниц.
import { contacts } from '../data/contacts';
interface Props { servicesHref?: string; blogHref?: string; }
const { servicesHref = '#formats', blogHref = '#blog' } = Astro.props;
const base = import.meta.env.BASE_URL;
const withBase = (href: string) => href.startsWith('/') ? `${base}${href.slice(1)}` : href;
const links = [
  { href: 'https://norma-studio.ru/', label: 'Полезные материалы ↓' },
  { href: 'https://norma-studio.ru/', label: 'О студии' },
  { href: withBase(blogHref), label: 'Блог' },
];
const services = [
  { label: 'Контент-маркетинг' },
  { label: 'Контент-стратегия' },
  { label: 'Ведение корпоративного блога', href: withBase('/services/vedenie-korporativnogo-bloga/') },
  { label: 'SEO-продвижение компании' },
  { label: 'GEO-продвижение', href: withBase('/services/geo-prodvizhenie/') },
  { label: 'SEO-статьи', href: withBase('/services/seo-stati/') },
  { label: 'Экспертные статьи' },
  { label: 'Email-рассылки', href: withBase('/services/email-rassylki/') },
  { label: 'Кейсы для бизнеса', href: withBase('/services/keisy-dlya-biznesa/') },
  { label: 'Статьи для внешних площадок', href: withBase('/services/articles-for-media/') },
  { label: 'Презентации и материалы для продаж', href: withBase('/services/prezentatsii-i-materialy-dlya-prodazh/') },
  { label: 'Дизайн, контент и разработка сайтов', href: withBase('/services/razrabotka-saitov/') },
];
---
<header class="site-header container">
  <div class="header-inner">
    <a class="brand" href={base} aria-label="Norma Studio — главная">Norma Studio</a>
    <nav class="desktop-nav" aria-label="Основная навигация">
      <details class="services-menu">
        <summary><span class="services-menu-label">Услуги</span> <span class="services-menu-arrow" aria-hidden="true">↓</span></summary>
        <div class="services-menu-panel">
          {services.map(service => (
            service.href ? <a href={service.href}>{service.label}</a> : <span>{service.label}</span>
          ))}
        </div>
      </details>
      {links.map(link => <a href={link.href}>{link.label}</a>)}
    </nav>
    <a class="header-contact" href={contacts.telegramChannel}>Про контент-маркетинг в Telegram <span aria-hidden="true">→</span></a>
    <details class="mobile-menu">
      <summary aria-label="Открыть меню"><span class="menu-icon" aria-hidden="true"><span></span><span></span><span></span></span></summary>
      <nav aria-label="Мобильная навигация">
        <details class="mobile-services-menu">
          <summary>Услуги <span aria-hidden="true">↓</span></summary>
          <div>
            {services.map(service => service.href ? <a href={service.href}>{service.label}</a> : <span>{service.label}</span>)}
          </div>
        </details>
        {links.map(link => <a href={link.href}>{link.label}</a>)}
      </nav>
    </details>
  </div>
</header>
<script>
  const menu = document.querySelector<HTMLDetailsElement>('.mobile-menu');
  const servicesMenu = document.querySelector<HTMLDetailsElement>('.services-menu');
  const servicesSummary = servicesMenu?.querySelector('summary');
  const hoverMenu = window.matchMedia('(hover: hover) and (pointer: fine)');
  const closeServicesMenu = () => { if (servicesMenu) servicesMenu.open = false; };
  servicesMenu?.addEventListener('pointerenter', () => { if (hoverMenu.matches) servicesMenu.open = true; });
  servicesMenu?.addEventListener('pointerleave', () => { if (hoverMenu.matches) closeServicesMenu(); });
  servicesMenu?.addEventListener('focusin', () => { if (servicesMenu) servicesMenu.open = true; });
  servicesMenu?.addEventListener('focusout', event => {
    if (!(event.relatedTarget instanceof Node) || !servicesMenu?.contains(event.relatedTarget)) closeServicesMenu();
  });
  servicesSummary?.addEventListener('click', event => { if (hoverMenu.matches) event.preventDefault(); });
  const toggle = menu?.querySelector('summary');
  menu?.addEventListener('toggle', () => {
    toggle?.setAttribute('aria-label', menu.open ? 'Закрыть меню' : 'Открыть меню');
  });
  menu?.querySelectorAll('a').forEach(link => link.addEventListener('click', () => { menu.open = false; }));
  document.addEventListener('keydown', event => {
    if (event.key === 'Escape' && menu?.open) { menu.open = false; toggle?.focus(); }
    if (event.key === 'Escape' && servicesMenu?.open) { servicesMenu.open = false; servicesMenu.querySelector('summary')?.focus(); }
  });
  document.addEventListener('click', event => {
    if (menu?.open && event.target instanceof Node && !menu.contains(event.target)) menu.open = false;
    if (servicesMenu?.open && event.target instanceof Node && !servicesMenu.contains(event.target)) servicesMenu.open = false;
  });
  servicesMenu?.querySelectorAll('a').forEach(link => link.addEventListener('click', () => { servicesMenu.open = false; }));

  const header = document.querySelector<HTMLElement>('.site-header');
  const footer = document.querySelector<HTMLElement>('.site-footer');
  if (header && footer) {
    let pending = false;
    const updateHeaderContrast = () => {
      pending = false;
      const headerRect = header.getBoundingClientRect();
      const footerRect = footer.getBoundingClientRect();
      header.classList.toggle('site-header-on-dark', footerRect.top <= headerRect.bottom && footerRect.bottom >= headerRect.top);
    };
    const scheduleHeaderContrast = () => {
      if (!pending) {
        pending = true;
        requestAnimationFrame(updateHeaderContrast);
      }
    };
    window.addEventListener('scroll', scheduleHeaderContrast, { passive: true });
    window.addEventListener('resize', scheduleHeaderContrast, { passive: true });
    updateHeaderContrast();
  }
</script>
