---
import { testimonials } from '../data/website-continuation';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
interface Props {
  items?: typeof testimonials;
  avatarImage?: ImageMetadata;
}
const { items = testimonials, avatarImage } = Astro.props;
---
<section class="testimonials container" aria-label="Отзывы клиентов">
  <div class="testimonial-stack">
    {items.map(item => (
      <figure class="testimonial">
        <blockquote><p>«{item.quote}»</p></blockquote>
        <figcaption>
          <span class="testimonial-avatar" aria-hidden="true">
            {avatarImage ? <Image src={avatarImage} alt="" width={438} format="webp" quality={90} loading="lazy" /> : item.initials}
          </span>
          <span class="testimonial-name">{item.name}</span>
          <span class="testimonial-company">{item.company}</span>
        </figcaption>
      </figure>
    ))}
  </div>
</section>
