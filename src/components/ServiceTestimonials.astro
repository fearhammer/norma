---
interface Props {
  items: { quote: string; name: string; company: string; initials: string }[];
}
const { items } = Astro.props;
---
<section class="testimonials container" aria-label="Отзывы клиентов">
  <div class="testimonial-stack">
    {items.map(item => (
      <figure class="testimonial">
        <blockquote><p>{item.quote}</p></blockquote>
        <figcaption>
          <span class="testimonial-avatar" aria-hidden="true">
            {item.initials}
          </span>
          <span class="testimonial-name">{item.name}</span>
          <span class="testimonial-company">{item.company}</span>
        </figcaption>
      </figure>
    ))}
  </div>
</section>
