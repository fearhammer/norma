---
const steps = [
  ['Нет проблемы', 'Всё ли работает как надо?', 'Не видит цену бездействия', 'Разбор скрытых потерь'],
  ['Осознание проблемы', 'Почему возникает сбой?', 'Не понимает причину', 'Диагностика и чек-листы'],
  ['Сравнение способов', 'Каким способом решить задачу?', 'Боится выбрать неверный подход', 'Сравнение подходов'],
  ['Выбор методологии', 'Как устроено решение?', 'Не хватает критериев оценки', 'Разбор технологии и требований'],
  ['Выбор подрядчика', 'Кому доверить проект?', 'Не доверяет обещаниям', 'Кейсы, сметы и критерии выбора'],
  ['Готовность к сделке', 'Как согласовать и начать?', 'Согласования и формальные риски', 'Порядок работы и ответы на возражения'],
];
---
<figure class="hunt-diagram">
  <figcaption>Лестница Ханта для B2B и сложных услуг</figcaption>
  <ol start="0">
    {steps.map(([title, question, barrier, format], i) => <li style={`--step: ${i}`}>
      <h3><span class="hunt-step">{i}.</span> {title}</h3>
      <div class="hunt-copy">
        <p>{question}</p>
        <p>Барьер: {barrier}. Контент: {format}.</p>
      </div>
    </li>)}
  </ol>
</figure>
<style>
  .hunt-diagram { width: min(61.25rem, calc(100vw - 40px)); margin: 2.5rem 0 2.5rem 50%; transform: translateX(-50%); }
  figcaption { margin-bottom: 24px; text-align: center; font-size: 1.5rem; font-weight: 500; color: var(--color-heading); }
  ol { display: flex; flex-direction: column; align-items: center; gap: 16px; list-style: none; padding: 0; margin: 0; }
  li { width: calc(55% + var(--step) * 9%); padding: 24px; text-align: center; border: 1px solid #e4d9cf; border-radius: 8px; background: #efe3d7; }
  li:nth-child(even) { background: #f4e6d9; }
  .hunt-diagram h3 { margin: 0 0 15px; font-size: 1.125rem; font-weight: 500; line-height: 1.2; }
  .hunt-copy { font-size: .875rem; line-height: 1.6; font-weight: 400; color: #454545; }
  .hunt-diagram .hunt-copy p { margin: 0; font: inherit; }
  .hunt-diagram .hunt-copy p + p { margin-top: 12px; }
  @media(max-width: 767px) { li { width: calc(85% + var(--step) * 3%); padding: 20px; } }
</style>
