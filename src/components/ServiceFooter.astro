---
import { contacts } from '../data/contacts';

interface Props { servicesHref?: string; blogHref?: string; contactHref?: string; }
const { servicesHref = '#formats', blogHref = '#blog', contactHref = '#consultation' } = Astro.props;

const navigation = [
  { label: 'Главная', href: import.meta.env.BASE_URL },
  { label: 'Услуги', href: servicesHref },
  { label: 'Блог', href: blogHref },
  { label: 'Контакты', href: contactHref },
];
const base = import.meta.env.BASE_URL;

// Остальные страницы услуг ещё готовятся: их названия остаются текстом до появления адресов.
const services = [
  ['Контент-маркетинг', 'Ведение корпоративного блога', 'GEO-продвижение', 'Экспертные статьи', 'Кейсы для бизнеса', 'Презентации и материалы для продаж'],
  ['Контент-стратегия', 'SEO-продвижение компании', 'SEO-статьи', 'Email-рассылки', 'Статьи для внешних площадок', 'Дизайн, контент и разработка сайтов'],
];
---

<footer class="site-footer" aria-label="Подвал сайта">
  <div class="footer-inner container">
    <div class="footer-top">
      <nav class="footer-navigation" aria-label="Навигация в подвале">
        <p class="footer-heading">Навигация</p>
        <ul class="footer-link-list">
          {navigation.map(item => <li><a href={item.href}>{item.label}</a></li>)}
        </ul>
      </nav>

      <div class="footer-services">
        <p class="footer-heading">Услуги</p>
        <div class="footer-service-columns">
          {services.map(column => (
            <ul class="footer-link-list">
              {column.map(item => <li>{item === 'Дизайн, контент и разработка сайтов' ? <a href={`${base}services/razrabotka-saitov/`}>{item}</a> : item === 'Кейсы для бизнеса' ? <a href={`${base}services/keisy-dlya-biznesa/`}>{item}</a> : item === 'Презентации и материалы для продаж' ? <a href={`${base}services/prezentatsii-i-materialy-dlya-prodazh/`}>{item}</a> : item === 'SEO-статьи' ? <a href={`${base}services/seo-stati/`}>{item}</a> : item === 'Email-рассылки' ? <a href={`${base}services/email-rassylki/`}>{item}</a> : item === 'Статьи для внешних площадок' ? <a href={`${base}services/articles-for-media/`}>{item}</a> : <span>{item}</span>}</li>)}
            </ul>
          ))}
        </div>
      </div>

      <div class="footer-about">
        <p class="footer-heading">Контент-студия</p>
        <span class="footer-privacy">Политика конфиденциальности</span>
      </div>
    </div>

    <div class="footer-contacts">
      <a href={contacts.telegram}>Написать в Telegram</a>
      <a href={`mailto:${contacts.email}`}>{contacts.email}</a>
    </div>

    <p class="footer-wordmark" aria-hidden="true">Norma Studio</p>
  </div>
</footer>
