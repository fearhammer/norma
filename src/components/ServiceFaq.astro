---
import { faq } from '../data/website-continuation';
interface Props { items?: { title: string; text: string | string[] }[]; }
const { items = faq } = Astro.props;
---
<section class="service-faq container section-space" id="faq" aria-labelledby="faq-title">
  <h2 id="faq-title">Частые вопросы</h2>
  <div class="faq-list">
    {items.map(item => (
      <details class="faq-item">
        <summary>{item.title}<span class="faq-toggle" aria-hidden="true"></span></summary>
        {(Array.isArray(item.text) ? item.text : [item.text]).map(paragraph => <p>{paragraph}</p>)}
      </details>
    ))}
  </div>
</section>
