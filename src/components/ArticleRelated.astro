---
interface Item { title: string; description: string; date: string; dateTime: string; readingTime: string; href?: string; }
interface Props { items: Item[]; allHref?: string; }
const { items, allHref } = Astro.props;
---
<section id="related" class="article-related container" aria-labelledby="article-related-title">
  <div class="article-related-heading">
    <h2 id="article-related-title">Другие материалы</h2>
    {allHref && <a href={allHref}>Смотреть все <span aria-hidden="true">↗</span></a>}
  </div>
  <div class="blog-grid">
    {items.map(item => <article class="blog-card article-related-card">
      {item.href ? <a class="blog-card-link" href={item.href} aria-label={`Читать: ${item.title}`}>
        <div class="article-meta"><span>{item.readingTime}</span><time datetime={item.dateTime}>{item.date}</time></div>
        <h3><span class="animated-underline">{item.title}</span></h3>
        <p>{item.description}</p>
        <span class="button" aria-hidden="true">Открыть блог <span>→</span></span>
      </a> : <div class="blog-card-link">
        <div class="article-meta"><span>{item.readingTime}</span><time datetime={item.dateTime}>{item.date}</time></div>
        <h3>{item.title}</h3>
        <p>{item.description}</p>
        <span class="button" aria-hidden="true">Открыть блог <span>→</span></span>
      </div>}
    </article>)}
  </div>
</section>
