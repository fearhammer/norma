---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
interface Item { title: string; image: ImageMetadata; imageAlt: string; category: string; date: string; dateTime: string; readingTime: string; href?: string; }
interface Props { items: Item[]; allHref?: string; }
const { items, allHref } = Astro.props;
---
<section id="related" class="article-related container" aria-labelledby="article-related-title">
  <div class="article-related-heading">
    <h2 id="article-related-title">Другие материалы</h2>
    {allHref && <a href={allHref}>Смотреть все <span aria-hidden="true">↗</span></a>}
  </div>
  <div class="article-related-grid">
    {items.map(item => <article class="article-related-card">
      {item.href ? <a href={item.href} aria-label={item.title}><Image src={item.image} alt={item.imageAlt} widths={[380, 640, 900]} sizes="(max-width: 767px) calc(100vw - 40px), 33vw" loading="lazy" /><div class="article-related-copy"><div class="article-related-meta"><span>{item.category}</span><time datetime={item.dateTime}>{item.date}</time></div><h3>{item.title}</h3><p>{item.readingTime} на чтение <span aria-hidden="true">↗</span></p></div></a> : <div><Image src={item.image} alt={item.imageAlt} widths={[380, 640, 900]} sizes="(max-width: 767px) calc(100vw - 40px), 33vw" loading="lazy" /><div class="article-related-copy"><div class="article-related-meta"><span>{item.category}</span><time datetime={item.dateTime}>{item.date}</time></div><h3>{item.title}</h3><p>{item.readingTime} на чтение</p></div></div>}
    </article>)}
  </div>
</section>
