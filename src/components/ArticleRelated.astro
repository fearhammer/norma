---
import { blogArticleDate, blogArticleHref, getRelatedArticles } from '../data/blogArticles';
import type { BlogArticleCard } from '../data/blogArticles';
import '../styles/article-related.css';

interface Props { currentSlug?: string; includePreviews?: boolean; title?: string; id?: string; className?: string; }
const { currentSlug = '', includePreviews = false, title = 'Другие материалы', id = 'related', className = '' } = Astro.props;
const { firstFeature, firstRow, secondFeature, secondRow } = getRelatedArticles(currentSlug, includePreviews);
---
<section id={id} class:list={['article-related', 'container', className]} aria-labelledby={`${id}-title`}>
  <div class="article-related-heading">
    <h2 id={`${id}-title`}>{title}</h2>
  </div>

  {firstFeature && <article class="blog-feature article-related-feature">
    <a class="blog-feature-link" href={blogArticleHref(firstFeature.slug)} aria-label={`Читать: ${firstFeature.title}`}>
      <div class="blog-feature-copy">
        <div class="article-meta"><span>{firstFeature.readingTime}</span><time datetime={firstFeature.dateTime}>{blogArticleDate(firstFeature.dateTime)}</time></div>
        <h3><span class="animated-underline">{firstFeature.title}</span></h3>
        <p>{firstFeature.description}</p>
        <span class="button" aria-hidden="true">Читать <span>→</span></span>
      </div>
      <div class="blog-cover" aria-hidden="true"></div>
    </a>
  </article>}

  {firstRow.length > 0 && <div class="blog-grid">
    {firstRow.map((item: BlogArticleCard) => <article class="blog-card">
      <a class="blog-card-link" href={blogArticleHref(item.slug)} aria-label={`Читать: ${item.title}`}>
        <div class="article-meta"><span>{item.readingTime}</span><time datetime={item.dateTime}>{blogArticleDate(item.dateTime)}</time></div>
        <h3><span class="animated-underline">{item.title}</span></h3>
        <p>{item.description}</p>
        <span class="button" aria-hidden="true">Читать <span>→</span></span>
      </a>
    </article>)}
  </div>}

  {secondFeature && <article class="blog-feature article-related-feature article-related-feature--reversed">
    <a class="blog-feature-link" href={blogArticleHref(secondFeature.slug)} aria-label={`Читать: ${secondFeature.title}`}>
      <div class="blog-feature-copy">
        <div class="article-meta"><span>{secondFeature.readingTime}</span><time datetime={secondFeature.dateTime}>{blogArticleDate(secondFeature.dateTime)}</time></div>
        <h3><span class="animated-underline">{secondFeature.title}</span></h3>
        <p>{secondFeature.description}</p>
        <span class="button" aria-hidden="true">Читать <span>→</span></span>
      </div>
      <div class="blog-cover" aria-hidden="true"></div>
    </a>
  </article>}

  {secondRow.length > 0 && <div class="blog-grid">
    {secondRow.map((item: BlogArticleCard) => <article class="blog-card">
      <a class="blog-card-link" href={blogArticleHref(item.slug)} aria-label={`Читать: ${item.title}`}>
        <div class="article-meta"><span>{item.readingTime}</span><time datetime={item.dateTime}>{blogArticleDate(item.dateTime)}</time></div>
        <h3><span class="animated-underline">{item.title}</span></h3>
        <p>{item.description}</p>
        <span class="button" aria-hidden="true">Читать <span>→</span></span>
      </a>
    </article>)}
  </div>}
</section>
