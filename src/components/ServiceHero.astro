---
import { Image, getImage } from 'astro:assets';
import hero from '../assets/website-hero.png';
import heroMobile from '../assets/photos/hero-mobile.jpg';
import { websiteService as content } from '../data/website-service';
import { contacts } from '../data/contacts';
import type { ImageMetadata } from 'astro';

interface Props {
  content?: { title: string; intro: string; summary: string; steps: string[] };
  image?: ImageMetadata;
  mobileImage?: ImageMetadata;
  imageAlt?: string;
  primaryAction?: string;
  primaryHref?: string;
  secondaryAction?: string;
  secondaryHref?: string;
  className?: string;
}

const {
  content: serviceContent = content,
  image = hero,
  mobileImage = heroMobile,
  imageAlt = 'Женщина и мужчина рассматривают материалы на мониторе за рабочим столом',
  primaryAction = 'Получить консультацию и примеры',
  primaryHref = contacts.consultation,
  secondaryAction = 'Обсудить задачу',
  secondaryHref = contacts.telegram,
  className = '',
} = Astro.props;

const mobileVariants = await Promise.all([480, 768, 1254].map(width =>
  getImage({ src: mobileImage, width, format: 'webp', quality: 95 })
));
const mobileSrcset = mobileVariants.map((image, index) => `${image.src} ${[480, 768, 1254][index]}w`).join(', ');
---
<section class:list={['service-hero', className]} aria-labelledby="service-title">
  <div class="hero-media" data-parallax>
    <picture>
      <source media="(max-width: 767px)" srcset={mobileSrcset} sizes="100vw" width={mobileImage.width} height={mobileImage.height} />
      <Image src={image} alt={imageAlt} widths={[960, 1440, 1920]} sizes="100vw" format="webp" quality={95} loading="eager" fetchpriority="high" class="hero-photo" />
    </picture>
  </div>
  <div class="hero-content container">
    <div class="hero-copy">
      <h1 id="service-title">{serviceContent.title}</h1>
      <p class="hero-intro">{serviceContent.intro}</p>
      <div class="hero-actions">
        <a class="button" href={primaryHref}>{primaryAction} <span aria-hidden="true">→</span></a>
        <a class="button button-plain" href={secondaryHref}>{secondaryAction} <span aria-hidden="true">→</span></a>
      </div>
      <ul class="hero-steps" aria-label="Состав работы">
        {serviceContent.steps.map(step => <li>{step}</li>)}
      </ul>
    </div>
    <p class="hero-summary">{serviceContent.summary}</p>
  </div>
</section>
