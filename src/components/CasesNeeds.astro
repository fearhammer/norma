---
import { Image } from 'astro:assets';
import photo from '../assets/photos/notebook-bag.jpg';

const situations = [
  {
    title: 'В портфолио есть интересные проекты, но о них не рассказано на сайте',
    paragraphs: [
      'Вы реализовали много проектов, но на сайте есть только логотипы заказчиков, отзывы и короткие описания. Подробности знают только сотрудники, а потенциальный клиент не видит, что именно вы сделали.',
      'Поможем выбрать проекты для публикации. Поговорим с участниками и подготовим кейсы, в которых расскажем о задаче заказчика, работе команды и результате.',
    ],
  },
  {
    title: 'Менеджерам по продажам нечего отправить в ответ на просьбу показать похожий проект',
    paragraphs: [
      'На встрече клиент спрашивает, решали ли вы такую задачу раньше. Менеджер может рассказать об опыте устно, а для отправки приходится собирать примеры из старых презентаций или уточнять подробности у коллег.',
      'Подготовим кейсы, которые можно отправлять вместе с коммерческим предложением.',
    ],
  },
  {
    title: 'Кейсы опубликованы, но не демонстрируют ценность продуктов или услуг компании',
    paragraphs: [
      'В описании есть этапы, инструменты и фраза «проект успешно завершён». При этом неясно, какие решения предложила команда, с чем пришлось разбираться и что в итоге получил заказчик.',
      'Вернёмся к материалам проекта и уточним детали у сотрудников. Перепишем кейс: объясним решения, покажем работу команды и расскажем, чего удалось добиться.',
    ],
  },
];
---

<section class="cases-needs" id="when-needed" aria-labelledby="cases-needs-title">
  <div class="container">
    <h2 id="cases-needs-title">Когда компании нужны кейсы</h2>
    <ol class="cases-needs-card">
      {situations.map((situation, index) => (
        <li>
          <span class="format-number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
          <h3>{situation.title}</h3>
          {situation.paragraphs.map(paragraph => <p>{paragraph}</p>)}
        </li>
      ))}
    </ol>
  </div>
  <div class="cases-needs-photo" data-parallax>
    <Image
      src={photo}
      alt="Сотрудница убирает блокнот в сумку, сидя в студии"
      widths={[640, 960, 1440, 1920]}
      sizes="100vw"
      format="webp"
      loading="lazy"
      decoding="async"
    />
  </div>
</section>
